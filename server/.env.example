# Local development: copy to server/.env (gitignored); `npm run dev` reads it.
# Everything has a local default, so an empty .env runs a full server with dev
# tokens, the in-memory store and pushes written to the log.

# PORT=8787
# HOST=0.0.0.0
# NODE_ENV=development
# LOG_LEVEL=info              # debug | info | warn | error | silent

# Auth: dev accepts tokens "dev:<userId>[:<name>]" (refused when NODE_ENV=production).
# AUTH_MODE=dev               # dev | supabase
# SUPABASE_URL=https://wbcnhvvakptoinwkulmn.supabase.co
# SUPABASE_JWT_SECRET=        # legacy HS256 secret: verifies user tokens locally (primary path)
# SUPABASE_PUBLISHABLE_KEY=   # optional apikey for the GET /auth/v1/user fallback (else the secret key)

# Storage: memory keeps everything in process; STORE_FILE also writes it to disk
# so a local server can restart mid play-by-post game.
# STORE=memory                # memory | supabase
# STORE_FILE=./.play-store.json
# SUPABASE_SECRET_KEY=        # sb_secret_… (SUPABASE_SERVICE_ROLE_KEY also accepted)

# Pushes: log prints what would be sent.
# PUSH_MODE=log               # log | expo
# EXPO_ACCESS_TOKEN=

# Who may connect: all (local default) or flag (feature_overrides.multiplayer ?? app_config.multiplayer).
# ACCESS=all

# Timing (ms). Defaults come from DEFAULT_TIMING in multiplayer/protocol.ts and
# reach every client in welcome.timing.
# HEARTBEAT_MS=25000
# IDLE_TIMEOUT_MS=70000
# RECONNECT_GRACE_MS=20000
# COUNTDOWN_MS=3000
# REMATCH_WINDOW_MS=30000
# EMOTE_COOLDOWN_MS=2000
# PARTY_GATHER_MS=6000
# LOBBY_HOST_WAIT_MS=120000
# ASYNC_OPEN_SEAT_TTL_MS=259200000
# ASYNC_INVITE_TTL_MS=86400000   # a play-by-post invite of any kind (live invites: 15 min direct/crew, 60 min link)
# AUTH_TIMEOUT_MS=5000
# SETTINGS_POLL_MS=60000
# MAX_ROOMS=5000
