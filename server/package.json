{
	"name": "ttp-play-server",
	"version": "0.1.0",
	"private": true,
	"description": "Tickle the Pig play server: the authoritative WebSocket host for matchmade games (rules shared from ../multiplayer).",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=.env src/index.ts",
		"build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --sourcemap --outfile=dist/index.js",
		"start": "node --enable-source-maps dist/index.js",
		"test": "tsx --test --test-timeout=60000 test/*.test.ts",
		"e2e": "tsx scripts/e2e.ts",
		"bot": "tsx scripts/bot.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.117.2",
		"jose": "^6.2.12",
		"ws": "^8.22.0"
	},
	"devDependencies": {
		"@types/node": "22.10.5",
		"@types/ws": "^8.18.2",
		"esbuild": "^0.28.2",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3"
	}
}
