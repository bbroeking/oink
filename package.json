{
	"name": "ttp",
	"main": "expo-router/entry",
	"version": "1.0.0",
	"engines": {
		"node": ">=22.13.0"
	},
	"scripts": {
		"start": "expo start",
		"android": "expo run:android",
		"android:local": "./scripts/run-android-local.sh",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"prototype:member-perks": "NODE_OPTIONS=--max-old-space-size=16384 expo start",
		"prototype:idle-battler": "NODE_OPTIONS=--max-old-space-size=16384 expo start --web",
		"prototype:lounge": "NODE_OPTIONS=--max-old-space-size=16384 expo start --web",
		"prototype:homegrown": "npm run prototype:homegrown:build && python3 -m http.server 4174 --directory docs",
		"prototype:homegrown:build": "node scripts/prototypes/homegrown-adventures/build.mjs",
		"prototype:homegrown:test": "node --test scripts/prototypes/homegrown-adventures/game.test.mjs",
		"prototype:adventure": "npm run prototype:adventure:build && python3 -m http.server 4174 --directory docs",
		"prototype:adventure:build": "node scripts/prototypes/adventures/build.mjs",
		"prototype:adventure:test": "node --test scripts/prototypes/adventures/game.test.mjs",
		"prototype:loadout": "node scripts/prototypes/rosies-loadout-sim/cli.mjs",
		"prototype:snatch-chain": "node scripts/prototypes/snatch-chain-sim/cli.mjs",
		"prototype:snatch-chain:web": "python3 -m http.server 4173 --directory scripts/prototypes/snatch-chain-sim",
		"test": "jest --watchAll",
		"test:quality": "node --test scripts/quality/contracts.test.mjs",
		"lint": "expo lint",
		"lint:web": "node scripts/lint-web.mjs",
		"build:tokens": "node scripts/build-web-tokens.mjs && node scripts/build-design-md.mjs",
		"quality:check": "node scripts/quality-loop.mjs --once",
		"quality:check:full": "node scripts/quality-loop.mjs --once --full",
		"quality:layout": "node scripts/quality-loop.mjs --once --scope layout",
		"quality:security": "node scripts/quality-loop.mjs --once --scope security",
		"quality:loop": "node scripts/quality-loop.mjs",
		"performance:benchmark": "node scripts/performance/benchmark-ios-export.mjs",
		"performance:poor-network": "node scripts/performance/benchmark-poor-network.mjs",
		"release:followups": "node tools/release-followups.mjs",
		"generate:pig-sprites": "python3 scripts/generate-pig-sprites.py",
		"verify:pig-markings": "python3 scripts/verify-pig-sprites.py",
		"verify:rive-assets": "scripts/rive/build-prototype-mesh-textures.sh",
		"verify:rive-pig": "node scripts/rive/verify-pig-rive.mjs",
		"verify:rive-pig:assets": "node scripts/rive/verify-pig-rive.mjs --assets-only",
		"verify:rive-homegrown": "node scripts/rive/verify-homegrown-rive.mjs",
		"verify:rive-mote-machine": "node scripts/rive/verify-mote-machine-rive.mjs",
		"test:rive-mote-machine-state-machine": "node scripts/rive/test-mote-machine-state-machine.mjs",
		"restore:rive-mote-machine": "node scripts/rive/restore-mote-machine-reels.mjs",
		"verify:rive-web": "node scripts/rive/verify-rive-web.mjs",
		"optimize": "python3 scripts/optimize_assets.py",
		"db:push": "npx supabase db push",
		"db:reset": "npx supabase db reset",
		"db:pull": "npx supabase db pull",
		"ship": "./scripts/ship-ios.sh",
		"scorecard": "node scripts/conformance-scorecard.mjs"
	},
	"jest": {
		"preset": "jest-expo",
		"setupFiles": [
			"./jest.setup.js"
		],
		"transformIgnorePatterns": [
			"node_modules/(?!(?:\\.pnpm/)?((jest-)?react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry|sentry-expo|@supabase|@rneui|@rn-primitives))"
		]
	},
	"dependencies": {
		"@babel/runtime": "^7.26.0",
		"@expo-google-fonts/caprasimo": "^0.4.0",
		"@expo-google-fonts/fredoka": "^0.4.1",
		"@expo-google-fonts/nunito": "^0.4.2",
		"@expo-google-fonts/patrick-hand": "^0.4.1",
		"@expo/dom-webview": "^57.0.1",
		"@expo/metro-runtime": "~57.0.9",
		"@expo/vector-icons": "^15.1.1",
		"@react-native-async-storage/async-storage": "2.2.0",
		"@rive-app/react-native": "0.4.19",
		"@rive-app/react-webgl2": "4.30.1",
		"@sentry/react-native": "~7.11.0",
		"@shopify/react-native-skia": "2.6.2",
		"@supabase/supabase-js": "^2.112.3",
		"expo": "~57.0.12",
		"expo-apple-authentication": "~57.0.1",
		"expo-asset": "~57.0.10",
		"expo-audio": "~57.0.3",
		"expo-camera": "~57.0.3",
		"expo-clipboard": "~57.0.1",
		"expo-constants": "~57.0.10",
		"expo-dev-client": "~57.0.11",
		"expo-font": "~57.0.1",
		"expo-haptics": "~57.0.1",
		"expo-linear-gradient": "~57.0.1",
		"expo-linking": "~57.0.5",
		"expo-notifications": "~57.0.10",
		"expo-router": "~57.0.12",
		"expo-splash-screen": "~57.0.6",
		"expo-status-bar": "~57.0.1",
		"expo-store-review": "~57.0.1",
		"expo-system-ui": "~57.0.2",
		"expo-video": "~57.0.2",
		"expo-web-browser": "~57.0.2",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-native": "0.86.2",
		"react-native-gesture-handler": "~2.32.0",
		"react-native-google-mobile-ads": "14.11.0",
		"react-native-nitro-modules": "0.35.10",
		"react-native-purchases": "^10.1.0",
		"react-native-purchases-ui": "^10.1.0",
		"react-native-reanimated": "~4.5.1",
		"react-native-safe-area-context": "5.7.0",
		"react-native-screens": "~4.26.2",
		"react-native-svg": "15.15.4",
		"react-native-url-polyfill": "^2.0.0",
		"react-native-web": "~0.21.2",
		"react-native-webview": "13.16.1",
		"react-native-worklets": "0.10.1"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@react-native/jest-preset": "0.86.2",
		"@react-native/metro-config": "0.86.2",
		"@sentry/cli": "2.42.4",
		"@types/jest": "^29.5.12",
		"@types/node": "^22.10.5",
		"@types/react": "~19.2.18",
		"@types/react-test-renderer": "19.1.0",
		"@typescript-eslint/eslint-plugin": "^8.63.0",
		"@typescript-eslint/parser": "^8.63.0",
		"esbuild": "0.28.1",
		"eslint": "^8.57.1",
		"eslint-config-expo": "~57.0.1",
		"eslint-plugin-expo": "^1.1.0",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-ttp": "file:tools/eslint-plugin-ttp",
		"jest": "^29.2.1",
		"jest-expo": "~57.0.4",
		"qrcode": "^1.5.4",
		"react-test-renderer": "19.2.3",
		"typescript": "^6.0.3"
	},
	"private": true,
	"expo": {
		"doctor": {
			"appConfigFieldsNotSyncedCheck": {
				"enabled": false
			}
		}
	}
}
