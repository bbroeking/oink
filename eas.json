{
  "cli": {
    "version": ">= 14.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_PRIVACY_URL": "https://bbroeking.github.io/oink/privacy.html"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_PRIVACY_URL": "https://bbroeking.github.io/oink/privacy.html"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_PRIVACY_URL": "https://bbroeking.github.io/oink/privacy.html"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6740339848"
      }
    }
  }
}
